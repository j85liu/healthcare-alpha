# Copy to .env and fill in. Never commit the real .env file.

# SEC EDGAR requires a descriptive User-Agent (name + contact email) on
# every request, not an API key. Set your contact info here rather than
# hardcoding it in shared/edgar.py.
EDGAR_USER_AGENT="Your Name your-email@example.com"

# CMS procedure-volume data (data.cms.gov) is public and does not require
# an API key. Left here in case a future dataset/endpoint does.
CMS_API_KEY=

# openFDA (device 510k / PMA endpoints) works without a key but allows a
# higher rate limit with one: https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=
